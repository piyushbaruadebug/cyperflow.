PORT=4000
JWT_SECRET=development-secret-key-12345

# Set to true only when the app is behind a trusted reverse proxy (for example Vercel/Render).
TRUST_PROXY=false
FRONTEND_URL=http://localhost:5173

# SMTP configuration for password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@pennywise-ai.local

# Groq API Key (Recommended for fast inference with Llama models)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional development seed account. Never commit real credentials.
DEMO_NAME=Demo User
DEMO_EMAIL=
DEMO_PASSWORD=
